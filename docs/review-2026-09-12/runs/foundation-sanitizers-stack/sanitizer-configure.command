cmake -S . -B build-review-sanitizers -DCMAKE_CXX_COMPILER=/usr/bin/clang++ -DCMAKE_BUILD_TYPE=Debug -DCMAKE_CXX_FLAGS=-O1\ -g\ -fsanitize=address\,undefined\ -fno-omit-frame-pointer -DOWT_KRYLOV_BUILD_TESTS=ON -DOWT_KRYLOV_BUILD_REVIEW_TESTS=OFF -DOWT_KRYLOV_ENABLE_MPI=OFF -DOWT_KRYLOV_ENABLE_PETSC=OFF -DOWT_KRYLOV_ENABLE_LAPACK=OFF -DOWT_KRYLOV_ENABLE_OPENMP_TARGET=OFF 
