+namespace detail {
+
+template<class Reduction, class T>
+[[nodiscard]] auto local_dot_and_norms(Reduction& reduction,
+    const BlockVector<T>& lhs, const BlockVector<T>& rhs)
+{
+    // Only fuse the native policies. Derived/custom policies may override
+    // local_dot(), and mixed or compensated policies retain their arithmetic.
+    using Policy = std::remove_cvref_t<Reduction>;
+    if constexpr (std::same_as<Policy, SerialReduction<T>>
+#ifdef OWT_KRYLOV_ENABLE_MPI
+                  || std::same_as<Policy, MpiReduction<T>>
+#endif
+    ) {
+        return reduction.local_dot_and_norms(lhs, rhs);
+    } else {
+        return std::array<local_scalar_t<Reduction, T>, 3>{
+            reduction.local_dot(lhs, rhs), reduction.local_dot(lhs, lhs),
+            reduction.local_dot(rhs, rhs)};
+    }
+}
