+    // Return {lhs.rhs, lhs.lhs, rhs.rhs} in one owned-vector traversal, with
+    // the same accumulator precision and per-product ordering as dot().
+    [[nodiscard]] std::array<T, 3> local_dot_and_norms(
+        const BlockVector<T>& lhs, const BlockVector<T>& rhs) const
+    {
+        if (!lhs.same_layout(rhs)) {
+            throw std::invalid_argument("dot layout mismatch");
+        }
+        using Accumulator = std::conditional_t<std::same_as<T, float>, double, T>;
+        std::array<Accumulator, 8> cross{}, left_squared{}, right_squared{};
+        const T* left = lhs.data();
+        const T* right = rhs.data();
+        const std::size_t size = lhs.owned_size();
+        std::size_t i = 0;
+        for (; i + cross.size() <= size; i += cross.size()) {
+            for (std::size_t lane = 0; lane < cross.size(); ++lane) {
+                const Accumulator a = static_cast<Accumulator>(left[i + lane]);
+                const Accumulator b = static_cast<Accumulator>(right[i + lane]);
+                cross[lane] += a * b;
+                left_squared[lane] += a * a;
+                right_squared[lane] += b * b;
+            }
+        }
+        auto combine = [](const auto& partial) {
+            return (partial[0] + partial[1]) + (partial[2] + partial[3])
+                + (partial[4] + partial[5]) + (partial[6] + partial[7]);
+        };
+        Accumulator ab = combine(cross);
+        Accumulator aa = combine(left_squared);
+        Accumulator bb = combine(right_squared);
+        for (; i < size; ++i) {
+            const Accumulator a = static_cast<Accumulator>(left[i]);
+            const Accumulator b = static_cast<Accumulator>(right[i]);
+            ab += a * b;
+            aa += a * a;
+            bb += b * b;
+        }
+        return {static_cast<T>(ab), static_cast<T>(aa), static_cast<T>(bb)};
+    }
